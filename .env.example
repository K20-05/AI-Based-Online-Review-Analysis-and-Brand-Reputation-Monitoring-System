# Flask session and seeded dashboard admin account
SECRET_KEY=replace-with-a-long-random-secret
DASHBOARD_ADMIN_EMAIL=admin@brandpulse.ai
DASHBOARD_ADMIN_PASSWORD=ReplaceWithAStrongPassword123!

# Runtime server settings
APP_HOST=0.0.0.0
APP_PORT=5000

# Allowed frontend origins for credentialed dashboard requests
# Example production value: https://your-frontend.example.com
ALLOWED_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:5500

# Set to 1 when serving the app behind HTTPS in production
SESSION_COOKIE_SECURE=0

# Optional MongoDB integration
MONGO_URI=
MONGO_DB_NAME=brand_review_analysis
MONGO_REVIEWS_COLLECTION=processed_reviews
MONGO_PREDICTIONS_COLLECTION=review_predictions
MONGO_REALTIME_REVIEWS_COLLECTION=realtime_reviews
MONGO_CONNECT_TIMEOUT_MS=2000
